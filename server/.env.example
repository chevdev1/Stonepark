# Copy to /etc/stonepark.env on the server (chmod 600) and fill in.
PORT=3000
HOST=127.0.0.1
# long random string; this is your owner password. Generate: openssl rand -base64 24
ADMIN_TOKEN=change-me
# your site origin(s), comma separated. Blocks other sites from using your backend.
ALLOWED_ORIGINS=https://stonepark.example,https://www.stonepark.example
DATA_DIR=/var/lib/stonepark
